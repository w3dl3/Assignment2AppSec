@model Assignment2.Models.ForgotPasswordViewModel

<h2 class="text-center">Forgot Password</h2>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <form asp-action="ForgotPassword" method="post" class="bg-light p-4 rounded shadow-sm">
                @Html.AntiForgeryToken()

                @if (!string.IsNullOrEmpty(ViewData["Message"] as string))
                {
                    <div class="alert alert-info text-center">@Html.Encode(ViewData["Message"])</div>
                }

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Enter your Email:</label>
                    <input asp-for="Email" class="form-control" required type="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Send Reset Link</button>
                </div>

                <div class="text-center mt-3">
                    <a asp-controller="Account" asp-action="Login">Back to Login</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
