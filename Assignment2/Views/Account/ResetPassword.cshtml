@model Assignment2.Models.ResetPasswordViewModel

<h2 class="text-center">Reset Password</h2>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <form asp-action="ResetPassword" method="post" class="bg-light p-4 rounded shadow-sm">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Token" />

                @if (!string.IsNullOrEmpty(ViewData["ErrorMessage"] as string))
                {
                    <div class="alert alert-danger text-center">@Html.Encode(ViewData["ErrorMessage"])</div>
                }

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">New Password:</label>
                    <input asp-for="NewPassword" type="password" class="form-control" required />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm New Password:</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Reset Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
